{
  "name": "happy-hour-code",
  "displayName": "Happy Hour Code",
  "description": "Play Game Boy Advance games from a VS Code sidebar, powered by mGBA.",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "happyHourCode",
          "title": "Happy Hour Code",
          "icon": "./icon.svg"
        }
      ]
    },
    "views": {
      "happyHourCode": [
        {
          "id": "happyHourCode.sidebar",
          "name": "Happy Hour Code",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "happy-hour-code.changeRomsFolder",
        "title": "Happy Hour Code: Change ROMs Folder…"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "dev:all": "npm-run-all -p watch webview:dev",
    "webview:dev": "cd webview && npm run dev",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:webview": "cd webview && npm run build",
    "build": "npm run build:webview && npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "publisher": "HappyHourCode"
}
